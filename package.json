{
  "name": "mdh-3d-store",
  "version": "2.0.0",
  "private": true,
  "description": "MDH 3D Store - ImpressÃ£o 3D Profissional no Rio de Janeiro",
  "author": "MDH 3D",
  "license": "MIT",
  "keywords": [
    "3d-printing",
    "ecommerce",
    "nextjs",
    "react",
    "supabase"
  ],
  "engines": {
    "node": ">=24.0.0 <26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "node scripts/lint.mjs --fix",
    "lint:check": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "echo 'Smoke tests: use npm run test:smoke'",
    "test:watch": "echo 'Tests temporarily disabled for deployment'",
    "test:coverage": "echo 'Tests temporarily disabled for deployment'",
    "test:smoke": "playwright test",
    "test:smoke:prod": "SMOKE_BASE_URL=${SMOKE_BASE_URL:-https://mdh-3d-store.vercel.app} playwright test",
    "doctor": "node scripts/doctor.mjs",
    "audit:seo-commercial": "node scripts/run-seo-commercial-audit.mjs",
    "validate": "npm run build && npm run typecheck && npm run lint:check && npm run doctor",
    "admin:hash": "node scripts/admin-hash.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "catalog:images": "node scripts/catalog-images.mjs",
    "catalog:portfolio": "node scripts/import-catalog-photos.mjs",
    "catalog:import-real": "node scripts/import-real-photos.mjs",
    "catalog:sync-downloads": "node scripts/sync-download-geek-assets.mjs",
    "sd:reference": "python scripts/generate_product_reference_sd.py",
    "analyze": "ANALYZE=true npm run build",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next out node_modules/.cache",
    "catalog:fill-images": "node scripts/fill-images-serpapi.mjs",
    "validate:storefront": "npm run db:generate && npm run build",
    "db:backup": "node scripts/backup-db.mjs",
    "validate:assets": "node scripts/validate-assets.mjs --baseUrl=http://127.0.0.1:3000 --manifest=output/CATALOG_SEMANTIC_AUDIT.json --publicMode=strict",
    "test:images": "playwright test tests/storefront-images.spec.ts",
    "gate:local": "npm run lint:check && npm run typecheck && npm run build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "validate:assets:fs": "node scripts/validate-assets.mjs --mode=fs --manifest=output/CATALOG_SEMANTIC_AUDIT.json --publicMode=strict",
    "validate:assets:http": "node scripts/validate-assets.mjs --mode=http --baseUrl=http://127.0.0.1:3000 --manifest=output/CATALOG_SEMANTIC_AUDIT.json --publicMode=strict",
    "report:weekly-growth": "node scripts/run-weekly-growth-report.mjs",
    "deploy:check:ultimate": "node scripts/pre-deploy-ultimate-check.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.49.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.4.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.8",
    "fflate": "^0.8.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "mercadopago": "^2.6.0",
    "next": "^15.5.13",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.4",
    "nodemailer": "^8.0.5",
    "openai": "^6.32.0",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^9.14.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.5",
    "three": "^0.183.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.13",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.13",
    "playwright": "^1.58.2",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "supabase": "^2.79.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wait-on": "^9.0.5"
  }
}
