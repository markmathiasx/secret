{
  "openapi": "3.1.0",
  "info": {
    "title": "MDH mobile API foundation",
    "version": "0.1.0",
    "description": "Checkout disabled. Isolated schema; existing website accounts not linked."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 1
          },
          "stock": {
            "type": "integer"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "modelUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "sellerId": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "recipient",
          "postalCode",
          "street",
          "number",
          "city",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "recipient": {
            "type": "string"
          },
          "postalCode": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "street": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "complement": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Database liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required or invalid"
          },
          "403": {
            "description": "Disabled account, unverified email, forbidden origin or insufficient role"
          },
          "500": {
            "description": "Sanitized internal error"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "summary": "Accurate feature flags",
