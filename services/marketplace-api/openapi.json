        ],
        "responses": {
          "204": {
            "description": "Success without response body"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required or invalid"
          },
          "403": {
            "description": "Disabled account, unverified email, forbidden origin or insufficient role"
          },
          "404": {
            "description": "Not found or not owned"
          },
