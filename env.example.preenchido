# Chatwoot Community (widget oficial + inbox)
# Base da sua instância self-hosted, ex.: https://chat.seudominio.com
NEXT_PUBLIC_CHATWOOT_BASE_URL=
# Token do Website Inbox criado no Chatwoot
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
# Opcional: URL direta do inbox/admin para o painel da equipe
CHATWOOT_ADMIN_URL=
# Opcional: HMAC do website widget para validar identidade de cliente logado
CHATWOOT_HMAC_TOKEN=
# Opcional: "live" quando houver equipe online em tempo real; padrão "messages"
NEXT_PUBLIC_CHATWOOT_AVAILABILITY=messages
# Canal público de suporte: "whatsapp" por padrão. Use "native" só se o chat interno estiver realmente operando.
NEXT_PUBLIC_SUPPORT_CHANNEL=whatsapp

# Admin (painel interno oculto)
ADMIN_EMAIL=markmathias01@gmail.com
# ADMIN_PASSWORD_HASH: gere com `node -e "const {scryptSync,randomBytes}=require('crypto'); const s=randomBytes(16).toString('hex'); console.log('scrypt:'+s+':'+scryptSync('SUA_SENHA_AQUI',s,64).toString('hex'))"`
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET: string aleatória longa (>= 32 chars) usada para assinar o cookie de sessão admin
ADMIN_SESSION_SECRET=COLOQUE_UMA_STRING_LONGA_E_ALEATORIA_AQUI

# Banco / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vpuynsrtytsveagsuebh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3KH0pYxfKxivugzDmKyjkw_Vyy1JUlQ
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI
SUPABASE_ORDERS_TABLE=orders
SUPABASE_QUOTES_TABLE=quotes
# Prisma requer ambas as URLs no Supabase:
# DATABASE_URL → Session Pooler (porta 5432) — usado em runtime pelo Prisma Client
DATABASE_URL=COLE_A_URI_DO_SESSION_POOLER_COM_SENHA_REAL_AQUI
# DIRECT_URL → Direct Connection (porta 5432 sem pooler) — exigida para `prisma migrate deploy`
DIRECT_URL=COLE_A_URI_DA_DIRECT_CONNECTION_COM_SENHA_REAL_AQUI

# Entrega por km / operação própria
