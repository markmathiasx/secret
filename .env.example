# MDH 3D Store - environment template
# Use placeholders only. Put real secrets in Vercel Environment Variables or local .env.local.

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL_WWW=https://www.example.com
NEXT_PUBLIC_VERCEL_FALLBACK_URL=https://example.vercel.app
AUTH_URL=https://example.com
AUTH_SECRET=<long-random-auth-secret>
AUTH_TRUST_HOST=true
AUTH_AUTO_VERIFY_LOCAL=false

# Public storefront contact
NEXT_PUBLIC_WHATSAPP_NUMBER=<whatsapp-number-e164-without-plus>
NEXT_PUBLIC_EXTRA_WHATSAPP_NUMBERS=
NEXT_PUBLIC_WHATSAPP_MESSAGE=<public-whatsapp-prefill-message>
NEXT_PUBLIC_SUPPORT_EMAIL=<public-support-email>
NEXT_PUBLIC_INSTAGRAM_URL=<public-instagram-url>
NEXT_PUBLIC_BRAND_INSTAGRAM_HANDLE=<public-instagram-handle>
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
STAFF_NOTIFY_EMAIL=<private-staff-notify-email>

# Admin and seed accounts
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD_HASH=<scrypt-password-hash>
ADMIN_SESSION_SECRET=<long-random-admin-session-secret>
CUSTOMER_SESSION_SECRET=<long-random-customer-session-secret>
SEED_SELLER_EMAIL=<seed-seller-email>
SEED_SELLER_PASSWORD=<seed-seller-password>
SEED_BUYER_EMAIL=<seed-buyer-email>
SEED_BUYER_PASSWORD=<seed-buyer-password>

# Database
POSTGRES_DB=<local-postgres-db>
POSTGRES_USER=<local-postgres-user>
POSTGRES_PASSWORD=<local-postgres-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://HOST:PORT
UPSTASH_REDIS_REST_URL=<upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# Mail
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
EMAIL_FROM=<from-email>
MAILHOG_HOST=127.0.0.1
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Uploads
UPLOADS_DIR=uploads
PRODUCT_MEDIA_DIR=uploads/products
MODEL_UPLOADS_DIR=uploads/stl
BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>
ORDER_BLOB_READ_WRITE_TOKEN=<vercel-blob-read-write-token>
R2_ACCOUNT_ID=<cloudflare-r2-account-id>
R2_ACCESS_KEY_ID=<cloudflare-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<cloudflare-r2-secret-access-key>
R2_BUCKET=<cloudflare-r2-bucket>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=<r2-public-base-url>

# Auth providers
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
APPLE_ID=<apple-service-id>
APPLE_SECRET=<apple-secret>
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Payments
NEXT_PUBLIC_MP_PUBLIC_KEY=<mercadopago-public-key>
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=<mercadopago-public-key>
MERCADOPAGO_ACCESS_TOKEN=<mercadopago-access-token>
MERCADOPAGO_WEBHOOK_SECRET=<mercadopago-webhook-secret>
MERCADOPAGO_APP_ID=<mercadopago-app-id>
MERCADOPAGO_PIX_EXPIRES_MINUTES=60
MERCADOPAGO_FALLBACK_EMAIL=<mercadopago-fallback-email>
MP_STATEMENT_DESCRIPTOR=<statement-descriptor>
MP_TIMEOUT_MS=15000
MP_DEBUG=false
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
PAGSEGURO_TOKEN=<pagseguro-token>

# Pix
NEXT_PUBLIC_PIX_PROVIDER=Pix
PIX_KEY=<pix-key-as-string>
PIX_RECEIVER_NAME=<pix-receiver-name>
PIX_RECEIVER_CITY=<pix-receiver-city>

# Supabase compatibility
SUPABASE_URL=<supabase-url>
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>
NEXT_PUBLIC_SUPABASE_URL=<supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_ORDERS_TABLE=orders
SUPABASE_QUOTES_TABLE=quotes
SUPABASE_QUOTE_REQUESTS_TABLE=quote_requests

# AI assistant
AI_PROVIDER=ai_gateway
AI_GATEWAY_API_KEY=<vercel-ai-gateway-api-key>
AI_GATEWAY_MODEL=<ai-gateway-model-id>
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=<openai-model-id>
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<groq-model-id>
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=<ollama-model-id>

# Delivery
DELIVERY_ORIGIN_LABEL=<origin-label>
GAS_PRICE_BRL=<gas-price-brl>
BIKE_KM_PER_LITER=<bike-km-per-liter>
DELIVERY_BASE_FEE=<delivery-base-fee>
DELIVERY_FEE_PER_KM=<delivery-fee-per-km>
DELIVERY_FEE_CAP=<delivery-fee-cap>
DELIVERY_EXPRESS_MULTIPLIER=<delivery-express-multiplier>
FREE_SHIPPING_THRESHOLD_BRL=<free-shipping-threshold-brl>
CHECKOUT_EXPRESS_MULTIPLIER=<checkout-express-multiplier>
MELHOR_ENVIO_TOKEN=<melhor-envio-access-token>
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br
MELHOR_ENVIO_FROM_POSTAL_CODE=<origin-postal-code>
MELHOR_ENVIO_USER_AGENT=MDH 3D Store (<support-email>)

# Sentry
SENTRY_DSN=<sentry-dsn>
NEXT_PUBLIC_SENTRY_DSN=<sentry-dsn>
SENTRY_ORG=<sentry-org>
SENTRY_PROJECT=<sentry-project>
SENTRY_AUTH_TOKEN=<sentry-auth-token>

# Analytics
NEXT_PUBLIC_GA4_ID=<ga4-measurement-id>
NEXT_PUBLIC_GA_MEASUREMENT_ID=<ga-measurement-id>
NEXT_PUBLIC_GTM_ID=<gtm-id>
NEXT_PUBLIC_FB_PIXEL_ID=<facebook-pixel-id>
NEXT_PUBLIC_TIKTOK_PIXEL_ID=<tiktok-pixel-id>
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<google-site-verification>

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:<support-email>

# Cron
CRON_SECRET=<long-random-cron-secret>

# WhatsApp Cloud API
WHATSAPP_MODE=simulated
WHATSAPP_ACCESS_TOKEN=<whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<whatsapp-phone-number-id>
WHATSAPP_APP_SECRET=<whatsapp-app-secret>
WHATSAPP_VERIFY_TOKEN=<whatsapp-verify-token>
WHATSAPP_TEMPLATE_NAME=<whatsapp-template-name>
WHATSAPP_OTP_TEMPLATE_NAME=<whatsapp-otp-template-name>
WHATSAPP_OTP_TEMPLATE_LOCALE=pt_BR
WHATSAPP_OTP_TEMPLATE_HAS_COPY_BUTTON=false
OTP_SECRET=<long-random-otp-secret>

# Meta Platform
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>
META_VERIFY_TOKEN=<meta-verify-token>
META_SYSTEM_USER_TOKEN=<meta-system-user-token>
META_BUSINESS_ID=<meta-business-id>
META_GRAPH_API_VERSION=v25.0
META_PAGE_ID=<meta-page-id>
META_IG_BUSINESS_ACCOUNT_ID=<meta-ig-business-account-id>
META_WABA_ID=<meta-waba-id>
META_PHONE_NUMBER_ID=<meta-phone-number-id>
META_BUSINESS_LOGIN_CONFIG_ID=<meta-business-login-config-id>
META_MARKETPLACE_CREATORS_CONFIG_ID=<meta-marketplace-creators-config-id>
META_INSTAGRAM_INTEGRATION_CONFIG_ID=<meta-instagram-integration-config-id>
META_WHATSAPP_MEASUREMENT_PARTNER_CONFIG_ID=<meta-whatsapp-measurement-partner-config-id>
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=<meta-whatsapp-embedded-signup-config-id>
META_SANDBOX_AD_ACCOUNT_ID=<meta-sandbox-ad-account-id>
META_ENABLE_FACEBOOK_SDK=false
META_ENABLE_BUSINESS_LOGIN=false
META_ENABLE_INSTAGRAM_PUBLISH=false
META_ENABLE_FACEBOOK_POSTING=false
META_ENABLE_WHATSAPP_OUTBOUND=false
META_ENABLE_MARKETING_API_SANDBOX=false
