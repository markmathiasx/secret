# App
NODE_ENV=development
# Production domain
NEXT_PUBLIC_SITE_URL=https://mdh3d.com.br
NEXT_PUBLIC_SITE_URL_WWW=https://www.mdh3d.com.br
NEXT_PUBLIC_VERCEL_FALLBACK_URL=https://mdh-3d-store.vercel.app
AUTH_URL=https://mdh3d.com.br
AUTH_SECRET=change-me-with-a-long-random-secret
AUTH_TRUST_HOST=true
AUTH_AUTO_VERIFY_LOCAL=true

# Brand and storefront
NEXT_PUBLIC_WHATSAPP_NUMBER=5521974137662
NEXT_PUBLIC_EXTRA_WHATSAPP_NUMBERS=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Oi! Vim pelo site da MDH 3D e quero um orçamento.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mdh_impressao3d/
NEXT_PUBLIC_BRAND_INSTAGRAM_HANDLE=mdh_impressao3d
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
STAFF_NOTIFY_EMAIL=mdhatendimento@gmail.com

# Admin and seed accounts
ADMIN_EMAIL=admin@mdh3d.local
ADMIN_PASSWORD=admin123456
SEED_SELLER_EMAIL=seller@mdh3d.local
SEED_SELLER_PASSWORD=seller123456
SEED_BUYER_EMAIL=buyer@mdh3d.local
SEED_BUYER_PASSWORD=buyer123456

# Database
POSTGRES_DB=mdh3d
POSTGRES_USER=mdh
POSTGRES_PASSWORD=mdh123
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdh:mdh123@localhost:5432/mdh3d?schema=public
DIRECT_URL=postgresql://mdh:mdh123@localhost:5432/mdh3d?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Upstash Redis (production — no package needed, REST API)
# Get these from https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mail / MailHog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MDH 3D Store <no-reply@mdh3d.local>
MAILHOG_HOST=127.0.0.1
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Uploads
UPLOADS_DIR=uploads
PRODUCT_MEDIA_DIR=uploads/products
MODEL_UPLOADS_DIR=uploads/stl

# Auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Mercado Pago test mode:
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_MP_PUBLIC_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_APP_ID=
MP_STATEMENT_DESCRIPTOR=MDH 3D
MP_TIMEOUT_MS=15000
MP_DEBUG=false
PAGSEGURO_TOKEN=

# Pix storefront defaults
NEXT_PUBLIC_PIX_PROVIDER=Pix
NEXT_PUBLIC_PIX_KEY=21974137662
NEXT_PUBLIC_CPF_SUFFIX=85
PIX_KEY=21974137662
PIX_RECEIVER_NAME=MDH 3D Store
PIX_RECEIVER_CITY=RIO DE JANEIRO

# Optional Supabase compatibility
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ORDERS_TABLE=orders
SUPABASE_QUOTES_TABLE=quotes
SUPABASE_QUOTE_REQUESTS_TABLE=quote_requests

# AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M

# Delivery
DELIVERY_ORIGIN_LABEL=Rio de Janeiro - RJ
GAS_PRICE_BRL=6
BIKE_KM_PER_LITER=35
DELIVERY_BASE_FEE=8
DELIVERY_FEE_PER_KM=0.6
DELIVERY_FEE_CAP=35
DELIVERY_EXPRESS_MULTIPLIER=2
FREE_SHIPPING_THRESHOLD_BRL=250
CHECKOUT_EXPRESS_MULTIPLIER=1.75

# Sentry error monitoring — https://sentry.io → New Project → Next.js
# SENTRY_DSN is server-side only; NEXT_PUBLIC_SENTRY_DSN also enables client-side
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Web Push Notifications (VAPID keys for PWA push)
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com.br

# Cron jobs — set a shared secret to protect cron endpoints
CRON_SECRET=change-me-with-a-long-random-secret

# Session secrets
CUSTOMER_SESSION_SECRET=change-me-customer-session
ADMIN_SESSION_SECRET=change-me-admin-session

# WhatsApp Cloud API
# WHATSAPP_MODE: "simulated" (dev/staging) or "cloud_api" (production)
# cloud_api requires WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID
# Get system-user token from Meta Business Suite → Settings → System Users → Generate Token
WHATSAPP_MODE=simulated
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Verify token for Meta webhook subscription (any random string you choose)
WHATSAPP_VERIFY_TOKEN=
# Order-update / notification template name (e.g. mdh_order_update)
WHATSAPP_TEMPLATE_NAME=mdh_order_update
# OTP-specific template (optional — omit to send free-form text OTP message)
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LOCALE=pt_BR
WHATSAPP_OTP_TEMPLATE_HAS_COPY_BUTTON=false
# Secret pepper for OTP hashing — change in production
OTP_SECRET=change-me-otp-secret

# Meta Platform (Facebook / Instagram / WhatsApp Business Cloud API)
# Get token: Meta Business Suite → Settings → System Users → Generate Token
META_APP_ID=SEU_META_APP_ID
META_APP_SECRET=SEU_META_APP_SECRET
META_VERIFY_TOKEN=SEU_META_VERIFY_TOKEN
# System user long-lived token — NEVER commit the real value, use Vercel env panel
META_SYSTEM_USER_TOKEN=COLE_SEU_TOKEN_APENAS_NO_ENV_LOCAL_OU_VERCEL
META_BUSINESS_ID=4453608518247627
META_GRAPH_API_VERSION=v25.0
META_PAGE_ID=SEU_META_PAGE_ID
META_IG_BUSINESS_ACCOUNT_ID=SEU_META_IG_BUSINESS_ACCOUNT_ID
META_WABA_ID=SEU_META_WABA_ID
META_PHONE_NUMBER_ID=SEU_META_PHONE_NUMBER_ID
# Config IDs (already created in Meta dashboard — do not change)
META_BUSINESS_LOGIN_CONFIG_ID=2053538095194681
META_MARKETPLACE_CREATORS_CONFIG_ID=1852036822135714
META_INSTAGRAM_INTEGRATION_CONFIG_ID=980413751182322
META_WHATSAPP_MEASUREMENT_PARTNER_CONFIG_ID=2567965270271995
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=2439354426585589
META_SANDBOX_AD_ACCOUNT_ID=26517234214566303
# Feature flags
META_ENABLE_FACEBOOK_SDK=true
META_ENABLE_BUSINESS_LOGIN=true
META_ENABLE_INSTAGRAM_PUBLISH=false
META_ENABLE_FACEBOOK_POSTING=false
META_ENABLE_WHATSAPP_OUTBOUND=false
META_ENABLE_MARKETING_API_SANDBOX=true
